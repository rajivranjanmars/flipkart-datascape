# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Unit test / coverage reports
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/
.pyre/

# Editors / IDEs
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Runtime logs
logs/
*.log

# Project data exports
data/*.csv
data/*.json
data/*.txt
data/*.zip
data/runs/

# Secrets: auth cookies for logged-in scraping (NEVER commit these)
secrets/*
!secrets/.gitkeep
*cookies*.json

# Local environment / proxy credentials (see .env.example) — NEVER commit this
.env

# Node dependencies (used only by tools/generate_batch_scraper_report.js)
node_modules/

# Unrelated / large local files that don't belong in this repo
*.rar
