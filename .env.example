# Copy this file to .env and fill in your residential proxy credentials.
# .env is gitignored — never commit real credentials.
#
# Only PROXY_SERVER is required to turn proxying on; leave all of these blank
# (or delete the file) to scrape without a proxy, same as before.
#
# Needed for Myntra: its CDN hard-blocks datacenter IPs, so it only works
# through a residential proxy. Flipkart, Amazon, and Meesho work without one.

# e.g. http://gate.residential-proxy-provider.com:8000 (check your provider's docs)
PROXY_SERVER=

# Leave blank if your provider embeds credentials in the server URL instead.
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional: comma-separated hosts/IPs to bypass the proxy for, e.g. localhost.
PROXY_BYPASS=
